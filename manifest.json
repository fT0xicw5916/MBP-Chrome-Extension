{
    "name": "ManageBac Plus",
    "description": "Just a simple Chrome extension built around ManageBac that adds a lot of useful functions to it.",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": [
        "tabs"
    ],
    "host_permissions": [
        "https://*.managebac.cn/*"
    ],
    "action": {
        "default_popup": "default.html"
    },
    "content_scripts": [
        {
            "js": ["scripts/content.js"],
            "matches": [
                "https://*.managebac.cn/student/classes*units",
                "https://*.managebac.cn/student/classes*core_tasks"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}