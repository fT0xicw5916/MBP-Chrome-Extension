{
    "name": "ManageBac Plus",
    "description": "Just a simple Chrome extension built around ManageBac that adds a lot of useful functions to it.",
    "version": "1.0.0",
    "manifest_version": 3,
    "permissions": [
        "tabs", "scripting", "storage"
    ],
    "host_permissions": [
        "https://*.managebac.cn/*"
    ],
    "action": {
        "default_popup": "default.html"
    },
    "content_scripts": [
        {
            "js": ["scripts/content_units.js"],
            "matches": ["https://*.managebac.cn/student/classes/*/units"]
        },
        {
            "js": ["scripts/content_core_tasks.js"],
            "matches": ["https://*.managebac.cn/student/classes/*/core_tasks"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}